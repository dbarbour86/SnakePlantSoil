{
  "version": 2,
  "builds": [
    {
      "src": "dist/server.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(assets/.*)",
      "dest": "/$1"
    },
    {
      "src": "/(robots.txt|sitemap.xml|favicon.ico|.*\\.png|.*\\.gif|.*\\.jpg|.*\\.svg)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/server.cjs"
    }
  ]
}
